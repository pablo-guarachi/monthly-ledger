{
  "expo": {
    "name": "Monthly Ledger",
    "slug": "monthly-ledger",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/visual-kit/platform/icon.png",
    "scheme": "monthlyledger",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F6F1E6",
    "android": {
      "package": "com.peo88.monthlyledger",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0F1D26",
        "foregroundImage": "./assets/visual-kit/platform/android-icon-foreground.png",
        "backgroundImage": "./assets/visual-kit/platform/android-icon-background.png",
        "monochromeImage": "./assets/visual-kit/platform/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/visual-kit/platform/splash-light.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F1E6",
          "dark": {
            "image": "./assets/visual-kit/platform/splash-dark.png",
            "backgroundColor": "#0F1D26"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/visual-kit/platform/notification-96.png",
          "color": "#17785F",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withReleaseSigning.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
